{
  "name": "computer-use-automation",
  "version": "0.1.0",
  "private": true,
  "description": "Computer-use automation system: LLM-driven discovery, deterministic replay, and human escalation for legacy back-office UIs.",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "mock-app": "tsx src/mock-app/server.ts",
    "cli": "tsx src/cli.ts",
    "run:discover": "tsx src/cli.ts run",
    "run:replay": "tsx src/cli.ts replay",
    "test": "vitest run"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "openai": "^4.68.4",
    "playwright": "^1.48.2",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.9.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^2.1.4"
  }
}
